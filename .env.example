# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iamcooked_dev"
DATABASE_URL_PRODUCTION="postgresql://..."

# Auth (Auth.js v5 — required for sign-in, dashboard, admin)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# NEXTAUTH_SECRET is accepted as a legacy alias by some tooling; prefer AUTH_SECRET
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
ADMIN_EMAILS="you@example.com"

# AI (optional — admin AI, copilot, digest intro)
OPENAI_API_KEY="sk-"
ANTHROPIC_API_KEY="sk-ant-"

# Email digest (optional)
RESEND_API_KEY="re_"
CRON_SECRET="generate-a-long-random-string"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Data sources (optional — OSV host is allowlisted to api.osv.dev only)
GITHUB_TOKEN="ghp_"
OSV_API_BASE_URL="https://api.osv.dev"

# Rate limiting (required in production — in-memory fallback is disabled there)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
